# Provedor do LLM: "ollama", "nvidia", "huggingface"
LLM_PROVIDER=ollama

# Configuração Ollama
OLLAMA_HOST=http://localhost:11434

# Modelos
LLM_MODEL=qwen2.5:7b
EMBED_MODEL_A=nomic-embed-text
EMBED_MODEL_B=bge-m3

# Provedores de API opcionais
HF_TOKEN=
NVIDIA_API_KEY=

# Servidor Gradio
SERVER_NAME=0.0.0.0
SERVER_PORT=7860
